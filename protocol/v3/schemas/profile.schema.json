{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"DBP3 Operational Profile",
  "type":"object",
  "required":["id","name","protected","suite","fec","max_records","replay_window","frame_sizes"],
  "properties":{
    "id":{"type":"integer","minimum":1,"maximum":65535},
    "name":{"type":"string","minLength":1},
    "protected":{"type":"boolean"},
    "suite":{"type":"string","minLength":1},
    "fec":{"type":"string","minLength":1},
    "max_records":{"type":"integer","minimum":1,"maximum":128},
    "replay_window":{"type":"integer","minimum":32,"maximum":65536},
    "frame_sizes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":[256,512,1024,2048,4096]}},
    "extends":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "requires":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "record_names":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "features":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "resource_class":{"enum":["embedded","edge","standard","high-throughput"]},
    "production":{"type":"boolean"}
  }
}
